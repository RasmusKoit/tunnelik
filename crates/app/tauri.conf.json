{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnelik",
  "version": "0.1.0",
  "identifier": "ee.koit.tunnelik",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tunnelik",
        "width": 920,
        "height": 620,
        "minWidth": 680,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
