<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 desktop6 rescap">

  <Identity Name="dev.koit.Tunnelik" Publisher="CN=Rasmus Koit" Version="0.3.12.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Tunnelik</DisplayName>
    <PublisherDisplayName>Rasmus Koit</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!--
      The window, in the Start menu as "Tunnelik". It also owns the `tunnelik` command: the alias
      runs the console program tunnelik.exe, which opens this window when run without arguments.
    -->
    <Application Id="App" Executable="tunnelik-app.exe" EntryPoint="Windows.FullTrustApplication"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Tunnelik"
        Description="A client for WireGuardÂ®"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="tunnelik.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="tunnelik.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!--
          Always on: the window or the command registers this task on network changes, sign-in
          and the user coming back, and it redials always-on tunnels Windows dropped. It runs in
          a background task host of Windows' own, loading the plugin DLL.
        -->
        <Extension Category="windows.backgroundTasks" EntryPoint="Tunnelik.TriggerTask">
          <BackgroundTasks>
            <Task Type="systemEvent" />
          </BackgroundTasks>
        </Extension>
        <!--
          "Start on its own": Windows dials a tunnel when a program starts or a name is looked up
          only for a profile handed to it through its MDM channel, which needs SYSTEM. This service
          does that one job for Tunnelik's own package. It is installed stopped; turning the
          feature on in the window or with `tunnelik trigger enable` starts it, with the
          administrator approval that takes. Installing a package with a service needs the same.
        -->
        <desktop6:Extension Category="windows.service" Executable="tunnelik_svc.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop6:Service Name="TunnelikMdm" StartupType="manual" StartAccount="localSystem" />
        </desktop6:Extension>
        <!--
          Subnet triggers are Tunnelik's own: this watcher, started at sign-in, dials a tunnel
          when a program first tries to reach one of its address ranges. It exits when no tunnel
          has one. Settings > Apps > Startup lists it, where the user can switch it off.
        -->
        <desktop:Extension Category="windows.startupTask" Executable="tunnelik_watch.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TunnelikWatch" Enabled="true" DisplayName="Tunnelik" />
        </desktop:Extension>
      </Extensions>
    </Application>

    <!--
      Hidden app whose only job is hosting the VPN plugin. Windows starts tunnelik_host.exe and
      creates the background task class in it for every VPN event (connect, packets, disconnect).
      Windows has no dedicated VPN plugin extension; a "vpnClient" background task is what makes
      the package show up as a VPN provider.
    -->
    <Application Id="Plugin" Executable="tunnelik_host.exe">
      <uap:VisualElements
        DisplayName="Tunnelik"
        Description="Tunnelik VPN plugin"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent"
        AppListEntry="none" />
      <Extensions>
        <Extension Category="windows.backgroundTasks" Executable="tunnelik_host.exe" EntryPoint="Tunnelik.VpnBackgroundTask">
          <BackgroundTasks>
            <uap:Task Type="vpnClient" />
          </BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- Restricted: fine for sideloading, need Microsoft's approval for the Store. -->
    <rescap:Capability Name="networkingVpnProvider" />
    <rescap:Capability Name="runFullTrust" />
    <!-- The TunnelikMdm service; see the App application. -->
    <rescap:Capability Name="packagedServices" />
    <rescap:Capability Name="localSystemServices" />
  </Capabilities>

  <!-- Windows requires the background task class to be registered; the DLL exports its factory. -->
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>tunnelik_plugin.dll</Path>
        <ActivatableClass ActivatableClassId="Tunnelik.VpnBackgroundTask" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="Tunnelik.TriggerTask" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>
</Package>
